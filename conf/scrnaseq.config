
params {
    config_profile_name        = 'dragenflow_rnaseq'
    config_profile_description = 'Dragenflow RNAseq'

    // Set workflow
    workflow                   = "rna"
    mark_duplicates            = true
    annotation_gtf             = "/storage2/fs1/dspencer/Active/shared/refdata/hg38/ensemble/Homo_sapiens.GRCh38.105.chr.sorted.gtf.gz"
    transcript_table           = "/storage2/fs1/dspencer/Active/shared/refdata/hg38/ensemble/Homo_sapiens.GRCh38.105.transcript_table.txt"

}

// Set dragen args here. 
process {
    withName: 'DRAGEN_MULTIALIGN' {
        ext.dragen_args  = { [ "--enable-rna true",
                               "-enable-single-cell-rna true",
                               "--scrna-filter-gene-biotypes true",
                               "--umi-source=read1",
                               "--scrna-barcode-position <BARCODE_START_AND_END_POS>", //
--scrna-umi-position <UMI_START_AND_END_POS> \             # see Barcode Position below on details for the format
--scrna-barcode-sequence-list <BARCODE_SEQUENCE_LIST_PATH>
                            ].join(' ').trim()
                            }
    }
}
